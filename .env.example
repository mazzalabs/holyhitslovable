# Environment variables
# Copy this file to .env and fill in your values.
# None of these are strictly required for the static demo – they are
# provided as extension points for future integrations.

# WhatsApp number used for the "Quero esse Plano" CTA buttons.
# Format: country code + DDD + number, no spaces or dashes.
VITE_WHATSAPP_NUMBER=5519996123792

# Optional: a backend endpoint to submit booking-inquiry forms.
# If left blank the app operates in frontend-only mode.
VITE_CONTACT_API_URL=
